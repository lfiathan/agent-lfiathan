# ═══════════════════════════════════════════════════════
#  Agent Lfiathan — Environment Variables
#  Copy this file to .env and fill in your values.
#  Lines starting with # are comments.
# ═══════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Strava API Credentials ───────────────────────────
# Required later for Strava OAuth integration and performance analysis.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Optional default redirect URI used by /api/strava/connect when redirectUri isn't provided.
# Example: https://your-app.com/strava/callback
STRAVA_REDIRECT_URI=
# Required for Strava webhook subscription verification.
# Use this value when creating the Strava webhook subscription.
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Optional: enables direct Telegram push for new Strava activity analysis.
STRAVA_ANALYSIS_TELEGRAM_BOT_TOKEN=
STRAVA_ANALYSIS_TELEGRAM_CHAT_ID=

# ─── Database (PostgreSQL) ───────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=lfiathan
DB_PASSWORD=your_database_password_here
DB_NAME=agent_lfiathan
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=lfiathan:
REDIS_DEFAULT_TTL=300

# ─── Transaction Email Import Job ────────────────────
# Optional: map parsed emails to a specific user in DB.
# TX_EMAIL_IMPORT_USER_ID=uuid_here
# TX_EMAIL_IMPORT_USER_EMAIL=you@example.com
# TX_EMAIL_IMPORT_MAX_EMAILS=200
# TX_EMAIL_IMPORT_LOOKBACK_DAYS=1
# TX_EMAIL_IMPORT_LOG_DIR=/opt/agent-lfiathan/logs/email-import
#
# Gmail is read over IMAP with a Google app password, not OAuth. Gmail's
# readonly scope is "restricted", so an unverified OAuth app stays in Testing
# mode where refresh tokens expire every 7 days — unusable for a scheduled job.
# Generate the password at myaccount.google.com -> Security -> App passwords
# (requires 2-Step Verification). It is 16 characters and does not expire.
# GMAIL_IMAP_USER=you@gmail.com
# GMAIL_IMAP_APP_PASSWORD=xxxxxxxxxxxxxxxx
#
# Optional fallback: when the rule-based parser cannot read an email, one LLM
# pass extracts the fields. Results are staged in pending-approvals for review
# and are never inserted directly, because a non-deterministic parse would
# break the exactly-once guarantee of transactions.source_fingerprint.
# Leave unset to disable — unreadable emails are then simply skipped.
# DEEPSEEK_API_KEY=sk-...
# LLM_EXTRACT_MODEL=deepseek-v4-flash
# LLM_EXTRACT_BASE_URL=https://api.deepseek.com

# ─── Weekly Financial Audit Job ───────────────────────
# FIN_AUDIT_TZ=Asia/Jakarta

# ─── Agent API Keys (openclaw or other API clients) ──
# JSON map of agent name -> { key, scopes }. Each key may only call routes
# under its own scopes (checked via the x-api-key header on every /api/*
# request). Generate each key with: openssl rand -hex 32
# Leave unset to disable auth entirely (local dev only — never in production).
#
# Write it on one line with no spaces: docker compose reads env_file literally
# and will not strip surrounding quotes the way dotenv does.
#
# AGENT_API_KEYS={"kara":{"key":"<generated>","scopes":["/api/transactions","/api/portfolio"]},"marcus":{"key":"<generated>","scopes":["/api/dietary","/api/strava"]},"lfiathan":{"key":"<generated>","scopes":["/api/users","/api/tasks","/api/transactions","/api/portfolio","/api/dietary","/api/strava"]}}

# ─── GitHub (for MCP & CI/CD) ───────────────────────
# Personal access token with repo + workflow permissions
# GITHUB_TOKEN=ghp_your_github_personal_access_token_here
# GITHUB_OWNER=lfiathan
# GITHUB_REPO=agent-lfiathan

# ─── VPS Deployment (used by CI/CD pipeline) ────────
# These are configured as GitHub Repository Secrets,
# not in this .env file. Listed here for reference:
#
# VPS_HOST       — Your VPS IP address or hostname
# VPS_USER       — SSH username (e.g. root)
# VPS_SSH_KEY    — Private SSH key for authentication
# VPS_PORT       — SSH port (default: 22)
# DEPLOY_PATH    — App directory on VPS (default: /opt/agent-lfiathan)
