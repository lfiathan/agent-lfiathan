# Ledger MCP server
#
# Values are normally supplied by the agent's workspace .mcp.json `env` block
# rather than a file, so each agent carries its own scoped key. This file
# exists for running the server by hand during development.

LFIATHAN_API_BASE=http://localhost:3000

# The agent's own entry from AGENT_API_KEYS. Use the key scoped to that agent,
# never a broader one — the server-side scope check is what keeps agents out of
# each other's data.
LFIATHAN_API_KEY=

# Ledger owner. Every tool is scoped to this user.
LFIATHAN_USER_ID=
